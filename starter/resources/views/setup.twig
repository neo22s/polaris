{% extends 'layout.twig' %}

{% block content %}
<section class="mx-auto max-w-md px-4 py-20">
    <h1 class="text-2xl font-semibold tracking-tight">{{ t('setup.title') }}</h1>
    <p class="mt-2 text-sm text-neutral-600">{{ t('setup.body') }}</p>

    {% if error %}
        <p class="mt-6 border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">{{ error }}</p>
    {% endif %}

    {% if link %}
        <p class="mt-6 border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-800">
            {{ t('setup.done') }}
        </p>
        <a class="mt-4 block break-all border border-neutral-200 px-3 py-2 text-sm" href="{{ link }}">{{ link }}</a>
        <p class="mt-4 text-xs text-neutral-500">{{ t('setup.link_help') }}</p>
    {% else %}
        <form method="post" action="/setup" class="mt-8 space-y-4">
            {{ csrf_field() }}
            <div>
                <label for="email" class="block text-sm font-medium">{{ t('field.email') }}</label>
                <input id="email" name="email" type="email" required autofocus autocomplete="email"
                       class="mt-1 w-full border border-neutral-300 px-3 py-2">
            </div>
            <button type="submit" class="w-full bg-ink px-5 py-2.5 text-white">{{ t('setup.create') }}</button>
        </form>
    {% endif %}
</section>
{% endblock %}
