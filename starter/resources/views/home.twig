{% extends 'layout.twig' %}

{% block content %}
<section class="mx-auto max-w-3xl px-4 py-16">
    <p class="text-xs uppercase tracking-[0.2em] text-neutral-500">{{ app_name }}</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight">{{ t('home.hero_title') }}</h1>
    <p class="mt-4 text-neutral-600">{{ t('home.hero_body') }}</p>

    <div class="mt-8 flex flex-wrap gap-3">
        {% if current_user %}
            <a href="{{ current_user.role == 'admin' ? '/admin' : '/dashboard' }}"
               class="bg-ink text-white px-5 py-2.5">{{ t('common.dashboard') }}</a>
        {% else %}
            <a href="/login" class="bg-ink text-white px-5 py-2.5">{{ t('auth.sign_in') }}</a>
        {% endif %}
    </div>

    <div class="mt-14 border-t border-neutral-200 pt-8">
        <h2 class="text-sm font-semibold uppercase tracking-[0.15em] text-neutral-500">{{ t('home.next_title') }}</h2>
        <ul class="mt-4 space-y-2 text-sm text-neutral-600">
            <li>{{ t('home.next_agents') }}</li>
            <li>{{ t('home.next_crud') }}</li>
            <li>{{ t('home.next_api') }}</li>
        </ul>
    </div>
</section>
{% endblock %}
