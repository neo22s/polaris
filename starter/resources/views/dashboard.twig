{% extends 'layout.twig' %}

{% block content %}
<section class="mx-auto max-w-2xl px-4 py-16">
    <h1 class="text-2xl font-semibold tracking-tight">{{ page_title }}</h1>
    <p class="mt-3 text-neutral-600">{{ t('dashboard.body') }}</p>

    <dl class="mt-8 grid grid-cols-2 gap-4 text-sm">
        <dt class="text-neutral-500">{{ t('common.email') }}</dt>
        <dd>{{ current_user.email }}</dd>
        <dt class="text-neutral-500">{{ t('common.role') }}</dt>
        <dd>{{ current_user.role }}</dd>
    </dl>

    <form method="post" action="/logout" class="mt-8">
        {{ csrf_field() }}
        <button type="submit" class="text-sm underline">{{ t('auth.sign_out') }}</button>
    </form>
</section>
{% endblock %}
