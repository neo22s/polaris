{% extends 'layout.twig' %}

{% block content %}
<section class="mx-auto max-w-sm px-4 py-20">
    <h1 class="text-2xl font-semibold tracking-tight">{{ t('auth.link_sent_title') }}</h1>
    <p class="mt-3 text-sm text-neutral-600">{{ t('auth.link_sent_body', {'email': email}) }}</p>
    <p class="mt-6 text-xs text-neutral-500">{{ t('auth.link_sent_help') }}</p>
    <a href="/login" class="mt-8 inline-block text-sm underline">{{ t('common.back') }}</a>
</section>
{% endblock %}
