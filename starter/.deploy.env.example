# FTP deployment credentials for bin/deploy.php
#
# Copy this file to .deploy.env and fill it in. .deploy.env is git-ignored and
# never packaged in a release: credentials live with the site, not with the
# framework.

FTP_HOST=ftp.your-domain.com
FTP_PORT=21
FTP_USER=
FTP_PASS=

# Remote document root (where index.php lives). The script also resolves the
# right path on chrooted accounts and looks under the per-domain directory when
# a provider reallocates the domain, but setting it correctly avoids the search.
# Examples:
#   /public_html
#   /home/u123/domains/example.com/public_html
FTP_ROOT=/public_html

# Passive mode is almost always required on shared hosting.
FTP_PASSIVE=true

# Explicit FTPS.
FTP_SSL=false

# Public site URL, used to call the one-off migration runner.
SITE_URL=https://your-domain.com

# Secret for that runner. Generate one with:
#   php -r "echo bin2hex(random_bytes(24));"
# The runner is uploaded, called once and deleted; this token is what stops
# anyone else from calling it in the seconds it exists.
DEPLOY_TOKEN=
