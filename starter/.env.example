# Application
APP_NAME=My Polaris site
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com

# Languages this site ships, first one is the default.
LOCALES=en,es

# Comma-separated emails that become admin on first login.
ADMIN_EMAILS=

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_PERSISTENT=false

# Session
SESSION_NAME=polaris_session
SESSION_LIFETIME=31536000
SESSION_REGENERATE_MINUTES=30

# Outgoing email (SMTP). Without it, magic links are only visible in the log.
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_SECURE=tls
MAIL_AUTH=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Polaris

# REST API and MCP. Both stay disabled while their key is empty.
API_ENABLED=true
API_KEY=
API_DOCS=false
MCP_ENABLED=true
MCP_API_KEY=

CACHE_ENABLED=true
