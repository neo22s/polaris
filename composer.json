{
    "name": "polarisphp/framework",
    "description": "Polaris - PHP full-stack starter kit framework for shared hosting.",
    "type": "library",
    "license": "MIT",
    "require": {
        "ext-mbstring": "*",
        "ext-pdo_mysql": "*",
        "php": ">=8.1",
        "php-di/php-di": "^7.1",
        "phpmailer/phpmailer": "^6.9 || ^7.0",
        "psr/container": "^1.1 || ^2.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15",
        "twig/twig": "^3.30"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Polaris\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Polaris\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        },
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "php bin/lint.php",
        "check": [
            "@lint",
            "@stan",
            "@test"
        ],
        "package": "php bin/package.php",
        "deploy": "php bin/deploy.php",
        "migrate": "php bin/migrate.php",
        "version": "php bin/version.php",
        "test:integration": "@php -r \"putenv('POLARIS_REQUIRE_INTEGRATION=1');\" && vendor/bin/phpunit",
        "stan": "phpstan analyse --no-progress --no-ansi"
    }
}
