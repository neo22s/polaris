# Application
APP_NAME=Polaris
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com

# Theme directory under themes/ to use. "base" is the kernel default.
THEME=base

# Comma-separated emails that become admin on first login.
ADMIN_EMAILS=

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=polaris
DB_USERNAME=root
DB_PASSWORD=
DB_PERSISTENT=false

# Session
SESSION_NAME=polaris_session
# One year: the cookie is renewed on every visit.
SESSION_LIFETIME=31536000
SESSION_REGENERATE_MINUTES=30

# Reverse proxies allowed to set X-Forwarded-Proto, comma separated.
# Leave empty without a proxy: the header is spoofable.
TRUSTED_PROXIES=

# Outgoing email (SMTP)
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_SECURE=
MAIL_AUTH=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Polaris

# Newsletter (optional, disabled without a token)
ACUMBAMAIL_ENABLED=false
ACUMBAMAIL_AUTH_TOKEN=
ACUMBAMAIL_LIST_EN=0
ACUMBAMAIL_LIST_ES=0
ACUMBAMAIL_DEFAULT_LOCALE=en

# Cache
CACHE_ENABLED=true

# REST API for the declared operations (disabled without a key of 32+ characters)
API_ENABLED=true
API_KEY=
# The generated OpenAPI document and docs page list every operation.
API_DOCS=false

# MCP HTTP endpoint (optional; disabled without a key of 32+ characters)
MCP_ENABLED=true
MCP_API_KEY=
MCP_MAX_BYTES=4194304
